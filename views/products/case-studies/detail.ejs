<% include ../partials/header %>

  <div class="tts-cs tts-cs--detail">

    <!-- Hero -->
    <section class="tts-cs__hero">
      <div class="container">
        <a class="tts-cs__back-link" href="/products/case-studies">
          &larr; All Case Studies
        </a>

        <p class="tts-cs__eyebrow">CUSTOMER SUCCESS STORY</p>

        <h1 class="tts-cs__hero-title">
          <%= caseStudy.title %>
        </h1>

        <p class="tts-cs__hero-summary">
          <%= caseStudy.summary %>
        </p>

        <p class="tts-cs__hero-meta">
          <strong>
            <%= caseStudy.customer %>
          </strong>
          <span aria-hidden="true">|</span>
          <%= caseStudy.location %>
        </p>
      </div>
    </section>

    <!-- Customer and project overview -->
    <section class="tts-cs__overview">
      <div class="container">
        <div class="row align-items-center">

          <div class="col-md-4 text-center mb-4 mb-md-0">
            <% if (caseStudy.logo) { %>
              <a href="<%= caseStudy.companyURL %>" target="_blank" rel="noopener noreferrer" aria-label="Visit <%= caseStudy.customer %> website (opens in a new tab)">
                <img class="tts-cs__customer-logo" src="<%= caseStudy.logo %>" alt="<%= caseStudy.customer %> logo" loading="lazy">
              </a>
              <% } %>
          </div>

          <div class="col-md-8">
            <p class="tts-cs__eyebrow">PROJECT OVERVIEW</p>

            <h2 class="tts-cs__section-title">
              A Better Approach to Quality Control
            </h2>

            <% caseStudy.overview.forEach(function(paragraph) { %>
              <p class="tts-cs__body-copy">
                <%= paragraph %>
              </p>
              <% }); %>

                <p class="tts-cs__product-line">
                  <strong>Technology:</strong>
                  <%= caseStudy.product %>
                </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Challenge and solution sections -->
    <% caseStudy.sections.forEach(function(section, index) { %>
      <section class="tts-cs__story-section">
        <div class="container">
          <div class="row align-items-center">

            <div class="col-md-6 <%= index % 2 === 1 ? 'order-md-2' : '' %>">
              <% if (section.image) { %>
                <a class="tts-cs__image-link" href="<%= section.image %>" data-lightbox-group="case-study" aria-label="Enlarge image: <%= section.imageAlt %>">
                  <img class="tts-cs__story-image" src="<%= section.image %>" alt="<%= section.imageAlt %>" loading="lazy">
                  <span class="tts-cs__image-hint">
                    View larger image
                  </span>
                </a>
                <% } %>
            </div>

            <div class="col-md-6 <%= index % 2 === 1 ? 'order-md-1' : '' %>">
              <p class="tts-cs__eyebrow">
                <%= index===0 ? 'THE CHALLENGE' : 'THE APPROACH' %>
              </p>

              <h2 class="tts-cs__section-title">
                <%= section.heading %>
              </h2>

              <% section.paragraphs.forEach(function(paragraph) { %>
                <p class="tts-cs__body-copy">
                  <%= paragraph %>
                </p>
                <% }); %>
            </div>

          </div>
        </div>
      </section>
      <% }); %>

        <!-- Results -->
        <section class="tts-cs__results">
          <div class="container">
            <p class="tts-cs__eyebrow">THE RESULTS</p>

            <h2 class="tts-cs__section-title tts-cs__results-title">
              Measurable Impact in the Field
            </h2>

            <div class="row">
              <% caseStudy.results.forEach(function(result) { %>
                <div class="col-md-6 col-lg-3">
                  <div class="tts-cs__result-card">
                    <p class="tts-cs__result-value">
                      <%= result.value %>
                    </p>
                    <p class="tts-cs__result-label">
                      <%= result.label %>
                    </p>
                  </div>
                </div>
                <% }); %>
            </div>
          </div>
        </section>

        <!-- Customer testimonial -->
        <% if (caseStudy.quote) { %>
          <section class="tts-cs__testimonial">
            <div class="container">
              <blockquote class="tts-cs__quote">
                <p>&ldquo;<%= caseStudy.quote %>&rdquo;</p>
                <footer>
                  <strong>
                    <%= caseStudy.quoteAttribution %>
                  </strong>
                </footer>
              </blockquote>
            </div>
          </section>
          <% } %>

            <!-- Related products -->
            <% if (caseStudy.relatedLinks && caseStudy.relatedLinks.length) { %>
              <section class="tts-cs__closing">
                <div class="container">
                  <h2 class="tts-cs__section-title">
                    <%= caseStudy.closingHeading %>
                  </h2>

                  <p class="tts-cs__body-copy">
                    <%= caseStudy.closingText %>
                  </p>
                  <div class="tts-cs__related-links">
                    <% caseStudy.relatedLinks.forEach(function(link) { %>
                      <a class="tts-cs__button" href="<%= link.url %>" <% if (/^https?:\/\//i.test(link.url)) { %>
                        target="_blank"
                        rel="noopener noreferrer"
                        <% } %>
                          >
                          <%= link.label %>
                            <span aria-hidden="true">&rarr;</span>
                      </a>
                      <% }); %>
                  </div>

                  <a class="tts-cs__back-link tts-cs__closing-back" href="/products/case-studies">
                    Explore All Case Studies
                  </a>
                </div>
              </section>
              <% } %>

  </div>

  <!-- Image lightbox -->
  <div class="tts-cs__lightbox" id="ttsCsLightbox" role="dialog" aria-modal="true" aria-label="Enlarged case study image" aria-hidden="true" hidden>
    <button class="tts-cs__lightbox-close" type="button" aria-label="Close enlarged image">&times;</button>

    <button class="tts-cs__lightbox-prev" type="button" aria-label="Previous image">&#10094;</button>

    <img class="tts-cs__lightbox-image" src="" alt="">

    <button class="tts-cs__lightbox-next" type="button" aria-label="Next image">&#10095;</button>

    <p class="tts-cs__lightbox-caption"></p>
  </div>

  <script src="/js/case-studies.js" defer></script>


  <% include ../partials/footer %>